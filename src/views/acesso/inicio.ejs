<%- include('../parciais/topo') %>
<% const nomes = { ADMIN_INSTITUCIONAL: 'Administração institucional', ADMIN_CAMPUS: 'Administração do campus', OPERADOR: 'Atendimento (entregas e devoluções)', CONSULTA: 'Consulta' }; %>
<h1>Início</h1>
<h2>Seus acessos</h2>
<ul>
  <% institucionais.forEach((p) => { %><li><%= nomes[p] %> — todos os campi</li><% }) %>
  <% acessos.forEach((a) => { %><li><strong><%= a.campus %>:</strong> <%= a.papeis.map((p) => nomes[p]).join(', ') %></li><% }) %>
</ul>
<% if (pendentes !== null) { %>
  <h2>Administração</h2>
  <p>
    <a class="br-button primary mr-2 mb-1" href="/acesso/solicitacoes">Solicitações de acesso<% if (pendentes > 0) { %> (<%= pendentes %> aguardando)<% } %></a>
    <% if (institucionais.includes('ADMIN_INSTITUCIONAL')) { %><a class="br-button secondary mb-1" href="/campi">Campi</a><% } %>
  </p>
  <% if (campiAdministrados.length) { %>
    <p class="mb-1">Por campus:</p>
    <ul>
      <% campiAdministrados.forEach((c) => { %>
        <li><strong><%= c.nome %>:</strong>
          <a href="/acesso/campi/<%= c.id %>/equipe" aria-label="Equipe de <%= c.nome %>">equipe</a> ·
          <a href="/campi/<%= c.id %>/configuracao" aria-label="Configuração de <%= c.nome %>">configuração</a> ·
          <a href="/campi/<%= c.id %>/oferta" aria-label="Anos letivos e cursos de <%= c.nome %>">anos letivos e cursos</a>
        </li>
      <% }) %>
    </ul>
  <% } %>
<% } %>
<%- include('../parciais/mensagem', { tipo: 'info', titulo: 'Funcionalidades em desenvolvimento.', corpo: 'Estoque, entregas e devoluções serão liberados nas próximas versões.' }) %>
<%- include('../parciais/rodape') %>
