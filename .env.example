# Copie para .env (que não vai para o Git) e preencha. Usado pelo compose.yaml de desenvolvimento.

# Cliente OAuth do Google (Aplicativo da Web). URI de redirecionamento: http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail(s) que viram o primeiro administrador institucional, só enquanto não houver nenhum.
BOOTSTRAP_ADMIN_EMAILS=

# Segredo das sessões (32+ caracteres aleatórios). Gere, por exemplo, com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
